{
  "collMod": "u_mes_matl_dispenseRecord",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_matl_dispenseRecord",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "productionOrderId",
        "productionOrderName",
        "itemId",
        "itemName",
        "lotId",
        "lotName",
        "dispenseMethod",
        "targetWeight",
        "tolerancePct",
        "tareWeight",
        "grossWeight",
        "netWeight",
        "unitOfMeasureId",
        "unitOfMeasureName",
        "pieceCount",
        "withinTolerance",
        "balanceGaugeId",
        "balanceGaugeName",
        "storageLocationId",
        "storageLocationName",
        "dispensedById",
        "dispensedBy",
        "dispensedAt",
        "verificationMethod",
        "verifiedById",
        "verifiedBy",
        "verifiedAt",
        "labelId",
        "labelName",
        "status",
        "schemaVersion",
        "createdAt",
        "createdById",
        "createdBy",
        "updatedAt",
        "updatedById",
        "updatedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "productionOrderId": {
          "bsonType": "string",
          "description": "Reference to u_mes_plan_productionOrder._id"
        },
        "productionOrderName": {
          "bsonType": "string",
          "description": "Display value of productionOrderId, copied from u_mes_plan_productionOrder.recordNo"
        },
        "itemId": {
          "bsonType": "string",
          "description": "Reference to u_mes_prod_item._id"
        },
        "itemName": {
          "bsonType": "string",
          "description": "Display value of itemId, copied from u_mes_prod_item.description"
        },
        "lotId": {
          "bsonType": "string",
          "description": "Reference to u_mes_plan_lot._id"
        },
        "lotName": {
          "bsonType": "string",
          "description": "Display value of lotId, copied from u_mes_plan_lot.recordNo"
        },
        "dispenseMethod": {
          "bsonType": "string",
          "description": "How the quantity is determined",
          "enum": [
            "Gravimetric Weighing",
            "Count By Weight"
          ]
        },
        "targetWeight": {
          "bsonType": "decimal",
          "description": "Target net weight"
        },
        "tolerancePct": {
          "bsonType": "decimal",
          "description": "Allowed deviation from the target (percent)"
        },
        "tareWeight": {
          "bsonType": "decimal",
          "description": "Tare weight of the container"
        },
        "grossWeight": {
          "bsonType": "decimal",
          "description": "Gross weight"
        },
        "netWeight": {
          "bsonType": "decimal",
          "description": "Net weight"
        },
        "unitOfMeasureId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_unitOfMeasure._id"
        },
        "unitOfMeasureName": {
          "bsonType": "string",
          "description": "Display value of unitOfMeasureId, copied from u_mes_mast_unitOfMeasure.name"
        },
        "pieceCount": {
          "bsonType": [
            "int",
            "null"
          ],
          "description": "Pieces calculated by count-by-weight; null for bulk material"
        },
        "withinTolerance": {
          "bsonType": "bool",
          "description": "Net weight within tolerance"
        },
        "balanceGaugeId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_qual_gauge._id: balance gauge"
        },
        "balanceGaugeName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of balanceGaugeId, copied from u_mes_qual_gauge.name"
        },
        "storageLocationId": {
          "bsonType": "string",
          "description": "Reference to u_mes_matl_storageLocation._id"
        },
        "storageLocationName": {
          "bsonType": "string",
          "description": "Display value of storageLocationId, copied from u_mes_matl_storageLocation.name"
        },
        "dispensedById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_user._id: user recorded for 'dispensed'"
        },
        "dispensedBy": {
          "bsonType": "string",
          "description": "Display name of the user in dispensedById, copied from u_mes_mast_user.fullName"
        },
        "dispensedAt": {
          "bsonType": "date",
          "description": "Time of dispensing"
        },
        "verificationMethod": {
          "bsonType": "string",
          "description": "How the dispense is verified",
          "enum": [
            "Second Person",
            "System Check"
          ]
        },
        "verifiedById": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_user._id: user recorded for 'verified'"
        },
        "verifiedBy": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display name of the user in verifiedById, copied from u_mes_mast_user.fullName"
        },
        "verifiedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Time of verification"
        },
        "labelId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_matl_label._id"
        },
        "labelName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of labelId, copied from u_mes_matl_label.recordNo"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Dispensed",
            "Verified",
            "Issued",
            "Returned",
            "Rejected"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        },
        "createdAt": {
          "bsonType": "date",
          "description": "Date and time the document was created. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "createdById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_user._id: user or process that created the document"
        },
        "createdBy": {
          "bsonType": "string",
          "description": "Display name of the creator, copied from u_mes_mast_user.fullName"
        },
        "updatedAt": {
          "bsonType": "date",
          "description": "Date and time of the most recent update. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "updatedById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_user._id: user or process that last updated the document"
        },
        "updatedBy": {
          "bsonType": "string",
          "description": "Display name of the last updater, copied from u_mes_mast_user.fullName"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
