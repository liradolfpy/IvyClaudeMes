{
  "collMod": "u_mes_matl_labelTemplate",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_matl_labelTemplate",
      "required": [
        "_id",
        "recordNo",
        "app",
        "siteId",
        "siteName",
        "name",
        "labelType",
        "customerId",
        "customerName",
        "standard",
        "widthMm",
        "heightMm",
        "printerLanguage",
        "symbology",
        "payloadPattern",
        "version",
        "copies",
        "effectiveFrom",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "app": {
          "bsonType": "string",
          "description": "Application context of the document: Auto = automotive caliper MES, Gamp = pharmaceutical GMP, Common = reference data shared by both",
          "enum": [
            "Auto",
            "Gamp",
            "Common"
          ]
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the label template; used as its display value in other collections"
        },
        "labelType": {
          "bsonType": "string",
          "description": "Label type",
          "enum": [
            "Unit Mark",
            "Container Label",
            "Shipping Label",
            "Hold Tag",
            "Location Label"
          ]
        },
        "customerId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_customer._id"
        },
        "customerName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of customerId, copied from u_mes_mast_customer.name"
        },
        "standard": {
          "bsonType": "string",
          "description": "Standard or specification the record refers to"
        },
        "widthMm": {
          "bsonType": "decimal",
          "description": "Width (mm)"
        },
        "heightMm": {
          "bsonType": "decimal",
          "description": "Height (mm)"
        },
        "printerLanguage": {
          "bsonType": "string",
          "description": "Printer language",
          "enum": [
            "ZPL",
            "EPL",
            "PDF"
          ]
        },
        "symbology": {
          "bsonType": "string",
          "description": "Symbology of the label template",
          "enum": [
            "Data Matrix ECC200",
            "QR Code",
            "Code 128",
            "Code 39",
            "PDF417"
          ]
        },
        "payloadPattern": {
          "bsonType": "string",
          "description": "Payload pattern"
        },
        "version": {
          "bsonType": "int",
          "description": "Version of the label template"
        },
        "copies": {
          "bsonType": "int",
          "description": "Copies of the label template"
        },
        "effectiveFrom": {
          "bsonType": "date",
          "description": "Effective from. Date field: calendar date only, stored as 00:00:00 of that day in local plant time (IST) with the +0000 suffix"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "In Preparation",
            "Released",
            "Obsolete"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
