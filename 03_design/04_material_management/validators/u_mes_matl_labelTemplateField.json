{
  "collMod": "u_mes_matl_labelTemplateField",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_matl_labelTemplateField",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "labelTemplateId",
        "labelTemplateName",
        "sequenceNo",
        "fieldName",
        "source",
        "fieldFormat",
        "positionXMm",
        "positionYMm",
        "isBarcode",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: <labelTemplateId>-F<nnn>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "labelTemplateId": {
          "bsonType": "string",
          "description": "Reference to u_mes_matl_labelTemplate._id: the parent document this one belongs to"
        },
        "labelTemplateName": {
          "bsonType": "string",
          "description": "Display value of labelTemplateId, copied from u_mes_matl_labelTemplate.name"
        },
        "sequenceNo": {
          "bsonType": "int",
          "description": "Position of this document in its list (within the same parent for child collections), starting at 1"
        },
        "fieldName": {
          "bsonType": "string",
          "description": "Field name"
        },
        "source": {
          "bsonType": "string",
          "description": "Where the record originated",
          "enum": [
            "MES Terminal",
            "PLC",
            "Scanner",
            "ERP",
            "Device",
            "Manual Entry"
          ]
        },
        "fieldFormat": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Field format"
        },
        "positionXMm": {
          "bsonType": "decimal",
          "description": "Position x (mm)"
        },
        "positionYMm": {
          "bsonType": "decimal",
          "description": "Position y (mm)"
        },
        "isBarcode": {
          "bsonType": "bool",
          "description": "True when the record is barcode"
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
