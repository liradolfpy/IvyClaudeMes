{
  "collMod": "u_mes_prod_recipe",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_prod_recipe",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "name",
        "equipmentId",
        "equipmentName",
        "itemId",
        "itemName",
        "operationId",
        "operationName",
        "version",
        "recipeType",
        "programNo",
        "effectiveFrom",
        "effectiveTo",
        "engineeringChangeId",
        "engineeringChangeName",
        "checksum",
        "approvedById",
        "approvedBy",
        "approvedAt",
        "lastDownloadedAt",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the recipe; used as its display value in other collections"
        },
        "equipmentId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_equipment._id"
        },
        "equipmentName": {
          "bsonType": "string",
          "description": "Display value of equipmentId, copied from u_mes_mast_equipment.name"
        },
        "itemId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_prod_item._id"
        },
        "itemName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of itemId, copied from u_mes_prod_item.description"
        },
        "operationId": {
          "bsonType": "string",
          "description": "Reference to u_mes_prod_operation._id"
        },
        "operationName": {
          "bsonType": "string",
          "description": "Display value of operationId, copied from u_mes_prod_operation.name"
        },
        "version": {
          "bsonType": "int",
          "description": "Version of the recipe"
        },
        "recipeType": {
          "bsonType": "string",
          "description": "Recipe type",
          "enum": [
            "Die Casting Parameters",
            "Furnace Profile",
            "CNC Program",
            "Washing Program",
            "Anodising Program",
            "Tightening Program",
            "Leak Test Program",
            "Laser Marking Program"
          ]
        },
        "programNo": {
          "bsonType": "string",
          "description": "Program number"
        },
        "effectiveFrom": {
          "bsonType": "date",
          "description": "Effective from (calendar date, stored as the start of that day in IST converted to UTC)"
        },
        "effectiveTo": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Effective to (calendar date, stored as the start of that day in IST converted to UTC)"
        },
        "engineeringChangeId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_prod_engineeringChange._id"
        },
        "engineeringChangeName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of engineeringChangeId, copied from u_mes_prod_engineeringChange.title"
        },
        "checksum": {
          "bsonType": "string",
          "description": "Checksum of the parameter set used to detect an unapproved change at the controller"
        },
        "approvedById": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_user._id: user recorded for 'approved'"
        },
        "approvedBy": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display name of the user in approvedById, copied from u_mes_mast_user.fullName"
        },
        "approvedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date and time when the record was approved"
        },
        "lastDownloadedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Last downloaded date and time"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "In Preparation",
            "Released",
            "Obsolete"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
