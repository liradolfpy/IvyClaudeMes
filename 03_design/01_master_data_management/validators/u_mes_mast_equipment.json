{
  "collMod": "u_mes_mast_equipment",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_mast_equipment",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "name",
        "equipmentTypeId",
        "equipmentTypeName",
        "equipmentClass",
        "lineId",
        "lineName",
        "workCenterId",
        "workCenterName",
        "parentEquipmentId",
        "parentEquipmentName",
        "manufacturerId",
        "manufacturerName",
        "model",
        "serialNo",
        "yearOfManufacture",
        "supplierId",
        "supplierName",
        "assetNo",
        "commissionedAt",
        "ratedCapacity",
        "ratedCapacityUnitOfMeasureId",
        "ratedCapacityUnitOfMeasureName",
        "ratedPowerKw",
        "controllerMake",
        "controllerModel",
        "controllerIpAddress",
        "controllerProtocol",
        "criticality",
        "currentState",
        "currentStateSince",
        "lifetimeCycles",
        "lifetimeRunHours",
        "nextMaintenanceDueAt",
        "calibrationRequired",
        "safetyCategory",
        "isProductionReady",
        "readinessReasonText",
        "healthScore",
        "healthScoreAt",
        "acquisitionCostInr",
        "plannedReplacementDate",
        "qualificationStatus",
        "requalificationDueDate",
        "cleanStatus",
        "cleanHoldExpiresAt",
        "lastCleaningRecordId",
        "lastCleaningRecordName",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the equipment; used as its display value in other collections"
        },
        "equipmentTypeId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_equipmentType._id"
        },
        "equipmentTypeName": {
          "bsonType": "string",
          "description": "Display value of equipmentTypeId, copied from u_mes_mast_equipmentType.name"
        },
        "equipmentClass": {
          "bsonType": "string",
          "description": "Equipment class",
          "enum": [
            "Production Equipment",
            "Test Equipment",
            "Measuring Equipment",
            "Utility"
          ]
        },
        "lineId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_line._id"
        },
        "lineName": {
          "bsonType": "string",
          "description": "Display value of lineId, copied from u_mes_mast_line.name"
        },
        "workCenterId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_workCenter._id"
        },
        "workCenterName": {
          "bsonType": "string",
          "description": "Display value of workCenterId, copied from u_mes_mast_workCenter.name"
        },
        "parentEquipmentId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_equipment._id: parent equipment"
        },
        "parentEquipmentName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of parentEquipmentId, copied from u_mes_mast_equipment.name"
        },
        "manufacturerId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_manufacturer._id"
        },
        "manufacturerName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of manufacturerId, copied from u_mes_mast_manufacturer.name"
        },
        "model": {
          "bsonType": "string",
          "description": "Model of the equipment"
        },
        "serialNo": {
          "bsonType": "string",
          "description": "Serial number"
        },
        "yearOfManufacture": {
          "bsonType": "int",
          "description": "Year of manufacture"
        },
        "supplierId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_supplier._id"
        },
        "supplierName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of supplierId, copied from u_mes_mast_supplier.name"
        },
        "assetNo": {
          "bsonType": "string",
          "description": "Asset number"
        },
        "commissionedAt": {
          "bsonType": "date",
          "description": "Date and time when the record was commissioned. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "ratedCapacity": {
          "bsonType": "decimal",
          "description": "Rated CAPAcity"
        },
        "ratedCapacityUnitOfMeasureId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_unitOfMeasure._id: rated CAPAcity unit of measure"
        },
        "ratedCapacityUnitOfMeasureName": {
          "bsonType": "string",
          "description": "Display value of ratedCapacityUnitOfMeasureId, copied from u_mes_mast_unitOfMeasure.name"
        },
        "ratedPowerKw": {
          "bsonType": "decimal",
          "description": "Rated power (kW)"
        },
        "controllerMake": {
          "bsonType": "string",
          "description": "Controller make"
        },
        "controllerModel": {
          "bsonType": "string",
          "description": "Controller model"
        },
        "controllerIpAddress": {
          "bsonType": "string",
          "description": "Controller ip address"
        },
        "controllerProtocol": {
          "bsonType": "string",
          "description": "Controller protocol",
          "enum": [
            "OPC UA",
            "Open Protocol",
            "Modbus TCP",
            "Profinet",
            "MQTT",
            "Ethernet/IP"
          ]
        },
        "criticality": {
          "bsonType": "string",
          "description": "A = failure stops the line or affects safety, B = reduced output, C = no immediate effect",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "currentState": {
          "bsonType": "string",
          "description": "Current state",
          "enum": [
            "Running",
            "Idle",
            "Setup",
            "Down",
            "Starved",
            "Blocked",
            "Planned Stop"
          ]
        },
        "currentStateSince": {
          "bsonType": "date",
          "description": "Current state since. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "lifetimeCycles": {
          "bsonType": "long",
          "description": "Lifetime cycles"
        },
        "lifetimeRunHours": {
          "bsonType": "decimal",
          "description": "Lifetime run hours"
        },
        "nextMaintenanceDueAt": {
          "bsonType": "date",
          "description": "Next maintenance due at. Date field: calendar date only, stored as 00:00:00 of that day in local plant time (IST) with the +0000 suffix"
        },
        "calibrationRequired": {
          "bsonType": "bool",
          "description": "True when: calibration required"
        },
        "safetyCategory": {
          "bsonType": "string",
          "description": "Performance level of the safety function (ISO 13849-1)",
          "enum": [
            "PL a",
            "PL b",
            "PL c",
            "PL d",
            "PL e"
          ]
        },
        "isProductionReady": {
          "bsonType": "bool",
          "description": "True when the equipment may receive work: not down, not in maintenance, PM and calibration not overdue"
        },
        "readinessReasonText": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Why the equipment is not production-ready; null when it is ready"
        },
        "healthScore": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Rule-based health score from 0 (failed) to 100 (as new)"
        },
        "healthScoreAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Time the health score was last calculated"
        },
        "acquisitionCostInr": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Purchase and installation cost (Indian rupees)"
        },
        "plannedReplacementDate": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Planned replacement date from the lifecycle review"
        },
        "qualificationStatus": {
          "bsonType": "string",
          "description": "Qualification status of the equipment (GMP-33, GMP-35)",
          "enum": [
            "Qualified",
            "Not Qualified",
            "Requalification Due"
          ]
        },
        "requalificationDueDate": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date the next requalification is due; null when not qualification-relevant"
        },
        "cleanStatus": {
          "bsonType": "string",
          "description": "Cleaning status shown on the equipment (GMP-34, GMP-35)",
          "enum": [
            "Clean",
            "Dirty",
            "In Cleaning",
            "Clean Hold Expired",
            "Not Applicable"
          ]
        },
        "cleanHoldExpiresAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "End of the clean hold time of the last cleaning"
        },
        "lastCleaningRecordId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_maint_cleaningRecord._id: last cleaning record"
        },
        "lastCleaningRecordName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of lastCleaningRecordId, copied from u_mes_maint_cleaningRecord.recordNo"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Active",
            "Under Maintenance",
            "Decommissioned"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
