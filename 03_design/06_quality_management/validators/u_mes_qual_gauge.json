{
  "collMod": "u_mes_qual_gauge",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_qual_gauge",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "name",
        "gaugeTypeId",
        "gaugeTypeName",
        "manufacturerId",
        "manufacturerName",
        "model",
        "serialNo",
        "rangeMin",
        "rangeMax",
        "rangeUnitOfMeasureId",
        "rangeUnitOfMeasureName",
        "resolution",
        "accuracy",
        "storageLocationId",
        "storageLocationName",
        "workCenterId",
        "workCenterName",
        "ownerUserId",
        "ownerUserName",
        "calibrationIntervalDays",
        "calibrationSource",
        "calibrationSupplierId",
        "calibrationSupplierName",
        "lastCalibratedAt",
        "nextCalibrationDueAt",
        "lastGaugeCalibrationId",
        "lastGaugeCalibrationName",
        "usageCount",
        "purchasedAt",
        "isMasterGauge",
        "blockedForUse",
        "equipmentId",
        "equipmentName",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the gauge; used as its display value in other collections"
        },
        "gaugeTypeId": {
          "bsonType": "string",
          "description": "Reference to u_mes_qual_gaugeType._id"
        },
        "gaugeTypeName": {
          "bsonType": "string",
          "description": "Display value of gaugeTypeId, copied from u_mes_qual_gaugeType.name"
        },
        "manufacturerId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_manufacturer._id"
        },
        "manufacturerName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of manufacturerId, copied from u_mes_mast_manufacturer.name"
        },
        "model": {
          "bsonType": "string",
          "description": "Model of the gauge"
        },
        "serialNo": {
          "bsonType": "string",
          "description": "Serial number"
        },
        "rangeMin": {
          "bsonType": "decimal",
          "description": "Range (minutes)"
        },
        "rangeMax": {
          "bsonType": "decimal",
          "description": "Range max"
        },
        "rangeUnitOfMeasureId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_unitOfMeasure._id: range unit of measure"
        },
        "rangeUnitOfMeasureName": {
          "bsonType": "string",
          "description": "Display value of rangeUnitOfMeasureId, copied from u_mes_mast_unitOfMeasure.name"
        },
        "resolution": {
          "bsonType": "decimal",
          "description": "Resolution of the gauge"
        },
        "accuracy": {
          "bsonType": "decimal",
          "description": "Accuracy of the gauge"
        },
        "storageLocationId": {
          "bsonType": "string",
          "description": "Reference to u_mes_matl_storageLocation._id"
        },
        "storageLocationName": {
          "bsonType": "string",
          "description": "Display value of storageLocationId, copied from u_mes_matl_storageLocation.name"
        },
        "workCenterId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_workCenter._id"
        },
        "workCenterName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of workCenterId, copied from u_mes_mast_workCenter.name"
        },
        "ownerUserId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_user._id: owner user"
        },
        "ownerUserName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of ownerUserId, copied from u_mes_mast_user.fullName"
        },
        "calibrationIntervalDays": {
          "bsonType": "int",
          "description": "Calibration interval (days)"
        },
        "calibrationSource": {
          "bsonType": "string",
          "description": "Calibration source",
          "enum": [
            "Internal",
            "External"
          ]
        },
        "calibrationSupplierId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_supplier._id: calibration supplier"
        },
        "calibrationSupplierName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of calibrationSupplierId, copied from u_mes_mast_supplier.name"
        },
        "lastCalibratedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Last calibrated date and time. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "nextCalibrationDueAt": {
          "bsonType": "date",
          "description": "Next calibration due at. Date field: calendar date only, stored as 00:00:00 of that day in local plant time (IST) with the +0000 suffix"
        },
        "lastGaugeCalibrationId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_qual_gaugeCalibration._id: last gauge calibration"
        },
        "lastGaugeCalibrationName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of lastGaugeCalibrationId, copied from u_mes_qual_gaugeCalibration.recordNo"
        },
        "usageCount": {
          "bsonType": "int",
          "description": "Usage count"
        },
        "purchasedAt": {
          "bsonType": "date",
          "description": "Date and time when the record was purchased. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "isMasterGauge": {
          "bsonType": "bool",
          "description": "True when the record is master gauge"
        },
        "blockedForUse": {
          "bsonType": "bool",
          "description": "True when: blocked for use"
        },
        "equipmentId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_equipment._id"
        },
        "equipmentName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of equipmentId, copied from u_mes_mast_equipment.name"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Active",
            "Due For Calibration",
            "Overdue",
            "Under Calibration",
            "Blocked",
            "Retired"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
