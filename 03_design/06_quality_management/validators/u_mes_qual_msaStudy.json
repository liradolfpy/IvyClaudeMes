        },
        "conductedById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_user._id: user recorded for 'conducted'"
        },
        "conductedBy": {
          "bsonType": "string",
          "description": "Display name of the user in conductedById, copied from u_mes_mast_user.fullName"
        },
        "approvedById": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_user._id: user recorded for 'approved'"
        },
        "approvedBy": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display name of the user in approvedById, copied from u_mes_mast_user.fullName"
        },
        "approvedAt": {
          "bsonType": [
            "date",
            "null"
          ],
