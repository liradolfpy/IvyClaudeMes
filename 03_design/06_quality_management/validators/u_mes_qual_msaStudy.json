      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "gaugeId",
        "gaugeName",
        "characteristicId",
        "characteristicName",
        "itemId",
        "itemName",
        "studyType",
        "studyMethod",
        "studyDate",
        "partsCount",
        "trialsCount",
        "resultsEquipmentVariation",
        "resultsAppraiserVariation",
        "resultsGrr",
        "resultsPartVariation",
        "resultsTotalVariation",
        "resultsGrrPctTolerance",
        "resultsGrrPctStudyVariation",
        "resultsNdc",
        "resultsBiasValue",
        "resultsKappa",
        "conclusion",
        "actionRequired",
        "conductedById",
        "conductedBy",
        "approvedById",
        "approvedBy",
        "approvedAt",
        "nextStudyDueAt",
        "status",
        "schemaVersion",
        "createdAt",
        "createdById",
        "createdBy",
        "updatedAt",
        "updatedById",
        "updatedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "gaugeId": {
          "bsonType": "string",
          "description": "Reference to u_mes_qual_gauge._id"
        },
        "gaugeName": {
          "bsonType": "string",
          "description": "Display value of gaugeId, copied from u_mes_qual_gauge.name"
        },
        "characteristicId": {
          "bsonType": "string",
          "description": "Reference to u_mes_qual_characteristic._id"
        },
        "characteristicName": {
          "bsonType": "string",
          "description": "Display value of characteristicId, copied from u_mes_qual_characteristic.name"
        },
        "itemId": {
          "bsonType": "string",
          "description": "Reference to u_mes_prod_item._id"
        },
        "itemName": {
          "bsonType": "string",
          "description": "Display value of itemId, copied from u_mes_prod_item.description"
        },
        "studyType": {
          "bsonType": "string",
