        "resultsGrr": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results grr"
        },
        "resultsPartVariation": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results part variation"
        },
        "resultsTotalVariation": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results total variation"
        },
        "resultsGrrPctTolerance": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results grr pct tolerance"
        },
        "resultsGrrPctStudyVariation": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results grr pct study variation"
        },
        "resultsNdc": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Number of distinct categories"
        },
        "resultsBiasValue": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results bias value"
        },
        "resultsKappa": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Results kappa"
