            "Planned",
            "Completed",
            "Accepted",
            "Not Accepted"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        },
        "createdAt": {
          "bsonType": "date",
          "description": "Date and time the document was created"
        },
        "createdById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_user._id: user or process that created the document"
        },
        "createdBy": {
          "bsonType": "string",
          "description": "Display name of the creator, copied from u_mes_mast_user.fullName"
        },
        "updatedAt": {
          "bsonType": "date",
          "description": "Date and time of the most recent update"
        },
        "updatedById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_user._id: user or process that last updated the document"
        },
        "updatedBy": {
          "bsonType": "string",
          "description": "Display name of the last updater, copied from u_mes_mast_user.fullName"
        }
      }
    }
