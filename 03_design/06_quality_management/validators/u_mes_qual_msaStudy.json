          "enum": [
            "Gauge R and R",
            "Bias",
            "Linearity",
            "Stability",
            "Attribute Agreement"
          ]
        },
        "studyMethod": {
          "bsonType": "string",
          "description": "Study method",
          "enum": [
            "ANOVA",
            "Average And Range",
            "Kappa"
          ]
        },
        "studyDate": {
          "bsonType": "date",
          "description": "Study date (calendar date, stored as the start of that day in IST converted to UTC)"
        },
        "partsCount": {
          "bsonType": "int",
          "description": "Parts count"
        },
        "trialsCount": {
          "bsonType": "int",
          "description": "Trials count"
        },
        "resultsEquipmentVariation": {
          "bsonType": [
            "decimal",
            "null"
          ],
