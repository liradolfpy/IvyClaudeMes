        "lowerSpecLimit": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Lower spec limit"
        },
        "upperSpecLimit": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Upper spec limit"
        },
        "capabilityCp": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "CAPAbility cp"
        },
        "capabilityCpk": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "CAPAbility cpk"
        },
        "capabilityPp": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "CAPAbility pp"
        },
        "capabilityPpk": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "CAPAbility ppk"
        },
        "capabilityCalculatedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Capability calculated date and time. Datetime field: local plant time (IST) stored with the +0000 suffix"
