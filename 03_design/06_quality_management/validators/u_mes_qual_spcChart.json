        },
        "chartType": {
          "bsonType": "string",
          "description": "Chart type",
          "enum": [
            "X-bar R",
            "X-bar S",
            "I-MR",
            "p",
            "np",
            "c",
            "u"
          ]
        },
        "subgroupSize": {
          "bsonType": "int",
          "description": "Subgroup size"
        },
        "subgroupFrequency": {
          "bsonType": "string",
          "description": "Subgroup frequency"
