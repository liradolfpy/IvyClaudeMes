        "itemId",
        "itemName",
        "workCenterId",
        "workCenterName",
        "equipmentId",
        "equipmentName",
        "chartType",
        "subgroupSize",
        "subgroupFrequency",
        "lowerSpecLimit",
        "upperSpecLimit",
        "capabilityCp",
        "capabilityCpk",
        "capabilityPp",
