        },
        "recipeId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_prod_recipe._id"
        },
        "recipeName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of recipeId, copied from u_mes_prod_recipe.name"
        },
        "curveType": {
          "bsonType": "string",
          "description": "Curve type",
