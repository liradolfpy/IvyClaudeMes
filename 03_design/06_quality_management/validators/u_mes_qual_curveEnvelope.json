            "Force Displacement",
            "Torque Angle",
            "Pressure Time",
            "Sound Spectrum",
            "Vibration Acceleration"
          ]
        },
        "xQuantity": {
          "bsonType": "string",
          "description": "X-axis quantity, e.g. Displacement"
        },
        "xUnitText": {
          "bsonType": "string",
          "description": "X-axis unit as delivered by the controller, e.g. mm, deg, ms"
        },
        "yQuantity": {
          "bsonType": "string",
          "description": "Y-axis quantity, e.g. Force"
        },
        "yUnitText": {
          "bsonType": "string",
          "description": "Y-axis unit as delivered by the controller, e.g. N, N.m, bar"
