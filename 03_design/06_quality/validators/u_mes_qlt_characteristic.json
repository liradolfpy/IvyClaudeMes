{
  "collMod": "u_mes_qlt_characteristic",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_qlt_characteristic",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "name",
        "itemId",
        "itemName",
        "operationId",
        "operationName",
        "characteristicType",
        "classification",
        "drawingZone",
        "balloonNo",
        "dataType",
        "nominal",
        "lowerSpecLimit",
        "upperSpecLimit",
        "unitOfMeasureId",
        "unitOfMeasureName",
        "toleranceType",
        "measurementMethod",
        "gaugeId",
        "gaugeName",
        "gaugeTypeId",
        "gaugeTypeName",
        "attributeAcceptance",
        "isSpc",
        "targetCpk",
        "reactionPlan",
        "source",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: CHR-<recordNo>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mdm_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the characteristic; used as its display value in other collections"
        },
        "itemId": {
          "bsonType": "string",
          "description": "Reference to u_mes_prd_item._id"
        },
        "itemName": {
          "bsonType": "string",
          "description": "Display value of itemId, copied from u_mes_prd_item.description"
        },
        "operationId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_prd_operation._id"
        },
        "operationName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of operationId, copied from u_mes_prd_operation.name"
        },
        "characteristicType": {
          "bsonType": "string",
          "description": "Characteristic type",
          "enum": [
            "Product",
            "Process"
          ]
        },
        "classification": {
          "bsonType": "string",
          "description": "Special characteristic class from the drawing or PFMEA",
          "enum": [
            "Critical",
            "Significant",
            "Standard"
          ]
        },
        "drawingZone": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Drawing zone"
        },
        "balloonNo": {
          "bsonType": "string",
          "description": "Balloon number"
        },
        "dataType": {
          "bsonType": "string",
          "description": "Data type",
          "enum": [
            "Variable",
            "Attribute"
          ]
        },
        "nominal": {
          "bsonType": "decimal",
          "description": "Nominal of the characteristic"
        },
        "lowerSpecLimit": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Lower spec limit"
        },
        "upperSpecLimit": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Upper spec limit"
        },
        "unitOfMeasureId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_unitOfMeasure._id"
        },
        "unitOfMeasureName": {
          "bsonType": "string",
          "description": "Display value of unitOfMeasureId, copied from u_mes_mdm_unitOfMeasure.name"
        },
        "toleranceType": {
          "bsonType": "string",
          "description": "Tolerance type",
          "enum": [
            "Bilateral",
            "Unilateral Upper",
            "Unilateral Lower"
          ]
        },
        "measurementMethod": {
          "bsonType": "string",
          "description": "Measurement method"
        },
        "gaugeId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_qlt_gauge._id"
        },
        "gaugeName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of gaugeId, copied from u_mes_qlt_gauge.name"
        },
        "gaugeTypeId": {
          "bsonType": "string",
          "description": "Reference to u_mes_qlt_gaugeType._id"
        },
        "gaugeTypeName": {
          "bsonType": "string",
          "description": "Display value of gaugeTypeId, copied from u_mes_qlt_gaugeType.name"
        },
        "attributeAcceptance": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Attribute acceptance"
        },
        "isSpc": {
          "bsonType": "bool",
          "description": "True when the record is spc"
        },
        "targetCpk": {
          "bsonType": [
            "decimal",
            "null"
          ],
          "description": "Target cpk"
        },
        "reactionPlan": {
          "bsonType": "string",
          "description": "Reaction plan"
        },
        "source": {
          "bsonType": "string",
          "description": "Where the record originated",
          "enum": [
            "MES Terminal",
            "PLC",
            "Scanner",
            "ERP",
            "Device",
            "Manual Entry"
          ]
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Active",
            "Inactive"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
