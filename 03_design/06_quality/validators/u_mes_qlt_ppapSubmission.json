{
  "collMod": "u_mes_qlt_ppapSubmission",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_qlt_ppapSubmission",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "itemId",
        "itemName",
        "itemRevision",
        "customerId",
        "customerName",
        "engineeringChangeId",
        "engineeringChangeName",
        "submissionLevel",
        "submissionReason",
        "controlPlanId",
        "controlPlanName",
        "pfmeaId",
        "pfmeaName",
        "sampleQuantity",
        "significantProductionRunQuantity",
        "pswSignedById",
        "pswSignedBy",
        "pswSignedAt",
        "submittedAt",
        "customerDecision",
        "customerDecisionAt",
        "customerRemarks",
        "interimApprovalValidTo",
        "status",
        "schemaVersion",
        "createdAt",
        "createdById",
        "createdBy",
        "updatedAt",
        "updatedById",
        "updatedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: PPAP-<recordNo>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mdm_site.name"
        },
        "itemId": {
          "bsonType": "string",
          "description": "Reference to u_mes_prd_item._id"
        },
        "itemName": {
          "bsonType": "string",
          "description": "Display value of itemId, copied from u_mes_prd_item.description"
        },
        "itemRevision": {
          "bsonType": "string",
          "description": "Item revision"
        },
        "customerId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_customer._id"
        },
        "customerName": {
          "bsonType": "string",
          "description": "Display value of customerId, copied from u_mes_mdm_customer.name"
        },
        "engineeringChangeId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_prd_engineeringChange._id"
        },
        "engineeringChangeName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of engineeringChangeId, copied from u_mes_prd_engineeringChange.title"
        },
        "submissionLevel": {
          "bsonType": "int",
          "description": "PPAP submission level 1 to 5"
        },
        "submissionReason": {
          "bsonType": "string",
          "description": "Submission reason",
          "enum": [
            "Initial Submission",
            "Engineering Change",
            "Tooling Transfer",
            "Correction Of Discrepancy",
            "Tooling Inactive Over One Year",
            "Sub Supplier Change"
          ]
        },
        "controlPlanId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_qlt_controlPlan._id"
        },
        "controlPlanName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of controlPlanId, copied from u_mes_qlt_controlPlan.recordNo"
        },
        "pfmeaId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_qlt_pfmea._id"
        },
        "pfmeaName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of pfmeaId, copied from u_mes_qlt_pfmea.title"
        },
        "sampleQuantity": {
          "bsonType": "int",
          "description": "Sample quantity"
        },
        "significantProductionRunQuantity": {
          "bsonType": "int",
          "description": "Significant production run quantity"
        },
        "pswSignedById": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mdm_user._id: user recorded for 'PSW signed'"
        },
        "pswSignedBy": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display name of the user in pswSignedById, copied from u_mes_mdm_user.fullName"
        },
        "pswSignedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Psw signed date and time"
        },
        "submittedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date and time when the record was submitted"
        },
        "customerDecision": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Customer decision",
          "enum": [
            "Approved",
            "Interim Approved",
            "Rejected",
            null
          ]
        },
        "customerDecisionAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Customer decision date and time"
        },
        "customerRemarks": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Customer remarks"
        },
        "interimApprovalValidTo": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Interim approval valid to (calendar date, stored as the start of that day in IST converted to UTC)"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "In Preparation",
            "Submitted",
            "Approved",
            "Interim Approved",
            "Rejected"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        },
        "createdAt": {
          "bsonType": "date",
          "description": "Date and time the document was created"
        },
        "createdById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_user._id: user or process that created the document"
        },
        "createdBy": {
          "bsonType": "string",
          "description": "Display name of the creator, copied from u_mes_mdm_user.fullName"
        },
        "updatedAt": {
          "bsonType": "date",
          "description": "Date and time of the most recent update"
        },
        "updatedById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_user._id: user or process that last updated the document"
        },
        "updatedBy": {
          "bsonType": "string",
          "description": "Display name of the last updater, copied from u_mes_mdm_user.fullName"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
