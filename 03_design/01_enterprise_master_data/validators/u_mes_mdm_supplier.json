{
  "collMod": "u_mes_mdm_supplier",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_mdm_supplier",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "name",
        "supplierType",
        "commodityId",
        "commodityName",
        "gstin",
        "addressLine1",
        "addressCity",
        "addressState",
        "addressPostalCode",
        "addressCountryId",
        "addressCountryName",
        "approvedAt",
        "ppmLast12Months",
        "deliveryRatingPct",
        "qualityRatingPct",
        "leadTimeDays",
        "paymentTermsDays",
        "currencyId",
        "currencyName",
        "isDirectedSource",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: SUP-<recordNo>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mdm_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the supplier; used as its display value in other collections"
        },
        "supplierType": {
          "bsonType": "string",
          "description": "Supplier type",
          "enum": [
            "Direct Material",
            "Indirect Material",
            "Tooling",
            "Service",
            "Calibration Laboratory"
          ]
        },
        "commodityId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_commodity._id"
        },
        "commodityName": {
          "bsonType": "string",
          "description": "Display value of commodityId, copied from u_mes_mdm_commodity.name"
        },
        "gstin": {
          "bsonType": "string",
          "description": "Goods and services tax identification number"
        },
        "addressLine1": {
          "bsonType": "string",
          "description": "Address line1"
        },
        "addressCity": {
          "bsonType": "string",
          "description": "Address city"
        },
        "addressState": {
          "bsonType": "string",
          "description": "Address state"
        },
        "addressPostalCode": {
          "bsonType": "string",
          "description": "Address postal code"
        },
        "addressCountryId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_country._id: address country"
        },
        "addressCountryName": {
          "bsonType": "string",
          "description": "Display value of addressCountryId, copied from u_mes_mdm_country.name"
        },
        "approvedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date and time when the record was approved"
        },
        "ppmLast12Months": {
          "bsonType": "int",
          "description": "Ppm last12 (months)"
        },
        "deliveryRatingPct": {
          "bsonType": "decimal",
          "description": "Delivery rating (percent)"
        },
        "qualityRatingPct": {
          "bsonType": "decimal",
          "description": "Quality rating (percent)"
        },
        "leadTimeDays": {
          "bsonType": "int",
          "description": "Lead time (days)"
        },
        "paymentTermsDays": {
          "bsonType": "int",
          "description": "Payment terms (days)"
        },
        "currencyId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_currency._id"
        },
        "currencyName": {
          "bsonType": "string",
          "description": "Display value of currencyId, copied from u_mes_mdm_currency.name"
        },
        "isDirectedSource": {
          "bsonType": "bool",
          "description": "True when the record is directed source"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Approved",
            "Conditional",
            "Blocked",
            "Inactive"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
