{
  "collMod": "u_mes_sys_erpMessage",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_sys_erpMessage",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "integrationConnectorId",
        "integrationConnectorName",
        "direction",
        "messageType",
        "idempotencyKey",
        "correlationNo",
        "relatedCollectionName",
        "relatedEntityId",
        "relatedEntityName",
        "productionOrderId",
        "productionOrderName",
        "goodsReceiptId",
        "goodsReceiptName",
        "shipmentId",
        "shipmentName",
        "payload",
        "payloadFormat",
        "payloadHash",
        "attempts",
        "maxAttempts",
        "createdInSourceAt",
        "receivedAt",
        "processedAt",
        "nextRetryAt",
        "errorCode",
        "errorText",
        "erpDocumentNo",
        "acknowledgedAt",
        "status",
        "schemaVersion",
        "createdAt",
        "createdById",
        "createdBy",
        "updatedAt",
        "updatedById",
        "updatedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: MSG-<recordNo>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mdm_site.name"
        },
        "integrationConnectorId": {
          "bsonType": "string",
          "description": "Reference to u_mes_sys_integrationConnector._id"
        },
        "integrationConnectorName": {
          "bsonType": "string",
          "description": "Display value of integrationConnectorId, copied from u_mes_sys_integrationConnector.name"
        },
        "direction": {
          "bsonType": "string",
          "description": "Direction of the ERP message",
          "enum": [
            "Inbound",
            "Outbound"
          ]
        },
        "messageType": {
          "bsonType": "string",
          "description": "Message type",
          "enum": [
            "Production Order Download",
            "Operation Confirmation",
            "Goods Movement",
            "Goods Receipt",
            "Shipment Advice",
            "Material Master",
            "Quality Notification"
          ]
        },
        "idempotencyKey": {
          "bsonType": "string",
          "description": "Key that makes repeated delivery of the same message harmless"
        },
        "correlationNo": {
          "bsonType": "string",
          "description": "Identifier shared by records that belong to the same business transaction"
        },
        "relatedCollectionName": {
          "bsonType": "string",
          "description": "Name of the collection the related document is in"
        },
        "relatedEntityId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "_id of the related document in the collection named by relatedCollectionName"
        },
        "relatedEntityName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of the related document"
        },
        "productionOrderId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_exe_productionOrder._id"
        },
        "productionOrderName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of productionOrderId, copied from u_mes_exe_productionOrder.recordNo"
        },
        "goodsReceiptId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mat_goodsReceipt._id"
        },
        "goodsReceiptName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of goodsReceiptId, copied from u_mes_mat_goodsReceipt.recordNo"
        },
        "shipmentId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mat_shipment._id"
        },
        "shipmentName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of shipmentId, copied from u_mes_mat_shipment.recordNo"
        },
        "payload": {
          "bsonType": "string",
          "description": "Payload of the ERP message"
        },
        "payloadFormat": {
          "bsonType": "string",
          "description": "Payload format",
          "enum": [
            "JSON",
            "XML",
            "IDoc"
          ]
        },
        "payloadHash": {
          "bsonType": "string",
          "description": "Payload hash"
        },
        "attempts": {
          "bsonType": "int",
          "description": "Attempts of the ERP message"
        },
        "maxAttempts": {
          "bsonType": "int",
          "description": "Maximum attempts"
        },
        "createdInSourceAt": {
          "bsonType": "date",
          "description": "Created in source date and time"
        },
        "receivedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date and time when the record was received"
        },
        "processedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date and time when the record was processed"
        },
        "nextRetryAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Next retry date and time"
        },
        "errorCode": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Error code"
        },
        "errorText": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Error text"
        },
        "erpDocumentNo": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "ERP document number"
        },
        "acknowledgedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Date and time when the record was acknowledged"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Queued",
            "Sent",
            "Acknowledged",
            "Failed",
            "Dead Letter"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        },
        "createdAt": {
          "bsonType": "date",
          "description": "Date and time the document was created"
        },
        "createdById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_user._id: user or process that created the document"
        },
        "createdBy": {
          "bsonType": "string",
          "description": "Display name of the creator, copied from u_mes_mdm_user.fullName"
        },
        "updatedAt": {
          "bsonType": "date",
          "description": "Date and time of the most recent update"
        },
        "updatedById": {
          "bsonType": "string",
          "description": "Reference to u_mes_mdm_user._id: user or process that last updated the document"
        },
        "updatedBy": {
          "bsonType": "string",
          "description": "Display name of the last updater, copied from u_mes_mdm_user.fullName"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
