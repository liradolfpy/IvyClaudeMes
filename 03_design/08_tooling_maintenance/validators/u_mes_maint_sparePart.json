{
  "collMod": "u_mes_maint_sparePart",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_maint_sparePart",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "description",
        "category",
        "manufacturerId",
        "manufacturerName",
        "manufacturerPartNo",
        "supplierId",
        "supplierName",
        "unitOfMeasureId",
        "unitOfMeasureName",
        "storageLocationId",
        "storageLocationName",
        "stockQuantity",
        "minimumQuantity",
        "reorderQuantity",
        "leadTimeDays",
        "unitCostInr",
        "criticality",
        "lastIssuedAt",
        "lastReceivedAt",
        "isInsuranceSpare",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "description": {
          "bsonType": "string",
          "description": "Description of the spare part"
        },
        "category": {
          "bsonType": "string",
          "description": "Category of the spare part",
          "enum": [
            "Mechanical",
            "Electrical",
            "Process",
            "Material",
            "Quality",
            "Organisation",
            "Planned"
          ]
        },
        "manufacturerId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_manufacturer._id"
        },
        "manufacturerName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of manufacturerId, copied from u_mes_mast_manufacturer.name"
        },
        "manufacturerPartNo": {
          "bsonType": "string",
          "description": "Manufacturer part number"
        },
        "supplierId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_supplier._id"
        },
        "supplierName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of supplierId, copied from u_mes_mast_supplier.name"
        },
        "unitOfMeasureId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_unitOfMeasure._id"
        },
        "unitOfMeasureName": {
          "bsonType": "string",
          "description": "Display value of unitOfMeasureId, copied from u_mes_mast_unitOfMeasure.name"
        },
        "storageLocationId": {
          "bsonType": "string",
          "description": "Reference to u_mes_matl_storageLocation._id"
        },
        "storageLocationName": {
          "bsonType": "string",
          "description": "Display value of storageLocationId, copied from u_mes_matl_storageLocation.name"
        },
        "stockQuantity": {
          "bsonType": "decimal",
          "description": "Stock quantity"
        },
        "minimumQuantity": {
          "bsonType": "decimal",
          "description": "Minimum quantity"
        },
        "reorderQuantity": {
          "bsonType": "decimal",
          "description": "Reorder quantity"
        },
        "leadTimeDays": {
          "bsonType": "int",
          "description": "Lead time (days)"
        },
        "unitCostInr": {
          "bsonType": "decimal",
          "description": "Unit cost (Indian rupees)"
        },
        "criticality": {
          "bsonType": "string",
          "description": "A = failure stops the line or affects safety, B = reduced output, C = no immediate effect",
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "lastIssuedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Last issued date and time. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "lastReceivedAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Last received date and time. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "isInsuranceSpare": {
          "bsonType": "bool",
          "description": "True when the record is insurance spare"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Active",
            "Obsolete"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
