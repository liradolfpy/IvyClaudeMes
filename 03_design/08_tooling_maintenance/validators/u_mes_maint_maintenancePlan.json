{
  "collMod": "u_mes_maint_maintenancePlan",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_maint_maintenancePlan",
      "required": [
        "_id",
        "recordNo",
        "app",
        "siteId",
        "siteName",
        "name",
        "equipmentId",
        "equipmentName",
        "toolId",
        "toolName",
        "planType",
        "strategy",
        "intervalType",
        "intervalValue",
        "intervalUom",
        "counterSource",
        "estimatedMinutes",
        "lastDoneAt",
        "nextDueAt",
        "toleranceDays",
        "blockEquipmentWhenOverdue",
        "ownerDepartmentId",
        "ownerDepartmentName",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: 16-digit numeric string, unique across the database"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "app": {
          "bsonType": "string",
          "description": "Application context of the document: Auto = automotive caliper MES, Gamp = pharmaceutical GMP, Common = reference data shared by both",
          "enum": [
            "Auto",
            "Gamp",
            "Common"
          ]
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "name": {
          "bsonType": "string",
          "description": "Name of the maintenance plan; used as its display value in other collections"
        },
        "equipmentId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_mast_equipment._id"
        },
        "equipmentName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of equipmentId, copied from u_mes_mast_equipment.name"
        },
        "toolId": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Reference to u_mes_maint_tool._id"
        },
        "toolName": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Display value of toolId, copied from u_mes_maint_tool.name"
        },
        "planType": {
          "bsonType": "string",
          "description": "Plan type",
          "enum": [
            "Incoming",
            "In Process",
            "First Off",
            "Final",
            "Dock Audit",
            "Layout"
          ]
        },
        "strategy": {
          "bsonType": "string",
          "description": "Strategy of the maintenance plan",
          "enum": [
            "Torque Control",
            "Torque Control Angle Monitor",
            "Angle Control Torque Monitor",
            "Yield Control"
          ]
        },
        "intervalType": {
          "bsonType": "string",
          "description": "Interval type",
          "enum": [
            "Calendar",
            "Counter",
            "Condition"
          ]
        },
        "intervalValue": {
          "bsonType": "decimal",
          "description": "Interval value"
        },
        "intervalUom": {
          "bsonType": "string",
          "description": "Interval uom",
          "enum": [
            "Days",
            "Weeks",
            "Months",
            "Cycles",
            "Shots",
            "Run Hours"
          ]
        },
        "counterSource": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Counter source"
        },
        "estimatedMinutes": {
          "bsonType": "int",
          "description": "Estimated (minutes)"
        },
        "lastDoneAt": {
          "bsonType": [
            "date",
            "null"
          ],
          "description": "Last done date and time. Datetime field: local plant time (IST) stored with the +0000 suffix"
        },
        "nextDueAt": {
          "bsonType": "date",
          "description": "Next due at. Date field: calendar date only, stored as 00:00:00 of that day in local plant time (IST) with the +0000 suffix"
        },
        "toleranceDays": {
          "bsonType": "int",
          "description": "Tolerance (days)"
        },
        "blockEquipmentWhenOverdue": {
          "bsonType": "bool",
          "description": "True when: block equipment when overdue"
        },
        "ownerDepartmentId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_department._id: owner department"
        },
        "ownerDepartmentName": {
          "bsonType": "string",
          "description": "Display value of ownerDepartmentId, copied from u_mes_mast_department.name"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Active",
            "Suspended",
            "Inactive"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
