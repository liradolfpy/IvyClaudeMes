{
  "collMod": "u_mes_syst_integrationConnectorFunction",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_syst_integrationConnectorFunction",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "integrationConnectorId",
        "integrationConnectorName",
        "sequenceNo",
        "functionName",
        "direction",
        "messageType",
        "endpointPath",
        "scheduleExpression",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: <integrationConnectorId>-F<nnn>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "integrationConnectorId": {
          "bsonType": "string",
          "description": "Reference to u_mes_syst_integrationConnector._id: the parent document this one belongs to"
        },
        "integrationConnectorName": {
          "bsonType": "string",
          "description": "Display value of integrationConnectorId, copied from u_mes_syst_integrationConnector.name"
        },
        "sequenceNo": {
          "bsonType": "int",
          "description": "Position of this document in its list (within the same parent for child collections), starting at 1"
        },
        "functionName": {
          "bsonType": "string",
          "description": "Function name"
        },
        "direction": {
          "bsonType": "string",
          "description": "Direction of the integration connector function",
          "enum": [
            "Inbound",
            "Outbound"
          ]
        },
        "messageType": {
          "bsonType": "string",
          "description": "Message type",
          "enum": [
            "Production Order Download",
            "Operation Confirmation",
            "Goods Movement",
            "Goods Receipt",
            "Shipment Advice",
            "Material Master",
            "Quality Notification"
          ]
        },
        "endpointPath": {
          "bsonType": "string",
          "description": "Endpoint path"
        },
        "scheduleExpression": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Cron expression for scheduled functions"
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
