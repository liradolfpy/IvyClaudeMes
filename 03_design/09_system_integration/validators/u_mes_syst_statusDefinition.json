{
  "collMod": "u_mes_syst_statusDefinition",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "title": "u_mes_syst_statusDefinition",
      "required": [
        "_id",
        "recordNo",
        "siteId",
        "siteName",
        "collectionName",
        "fieldName",
        "statusCode",
        "statusName",
        "description",
        "sequenceNo",
        "isInitial",
        "isFinal",
        "colourCode",
        "status",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "_id": {
          "bsonType": "string",
          "description": "Unique identifier of the document. Pattern: STD-<recordNo>"
        },
        "recordNo": {
          "bsonType": "string",
          "description": "Business identifier of the document, readable by people and unique within the site"
        },
        "siteId": {
          "bsonType": "string",
          "description": "Reference to u_mes_mast_site._id: the site the document belongs to"
        },
        "siteName": {
          "bsonType": "string",
          "description": "Display value of the site, copied from u_mes_mast_site.name"
        },
        "collectionName": {
          "bsonType": "string",
          "description": "Collection name"
        },
        "fieldName": {
          "bsonType": "string",
          "description": "Field name"
        },
        "statusCode": {
          "bsonType": "string",
          "description": "Stable code for the status value, upper case with underscores"
        },
        "statusName": {
          "bsonType": "string",
          "description": "Status name"
        },
        "description": {
          "bsonType": "string",
          "description": "Description of the status definition"
        },
        "sequenceNo": {
          "bsonType": "int",
          "description": "Position of this document in its list (within the same parent for child collections), starting at 1"
        },
        "isInitial": {
          "bsonType": "bool",
          "description": "True when the record is initial"
        },
        "isFinal": {
          "bsonType": "bool",
          "description": "True when the record is final"
        },
        "colourCode": {
          "bsonType": [
            "string",
            "null"
          ],
          "description": "Colour code"
        },
        "status": {
          "bsonType": "string",
          "description": "Primary lifecycle state of the document",
          "enum": [
            "Active",
            "Inactive"
          ]
        },
        "schemaVersion": {
          "bsonType": "int",
          "description": "Version of this collection's document structure, starting at 1"
        }
      }
    }
  },
  "validationLevel": "strict",
  "validationAction": "error"
}
