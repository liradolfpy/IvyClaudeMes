# Copy this file to 07_database_scripts/MongoDocUpload/.env and fill in the values.
# .env is listed in .gitignore and must never be committed or shared.
# Better still: leave MONGO_PASSWORD empty; the script then asks for it without echo.
MONGO_HOST=localhost:27017
MONGO_USER=mes_loader
MONGO_PASSWORD=
MONGO_DB=mes
MONGO_SRV=0
MONGO_AUTH_DB=admin
MONGO_TLS=0
DRY_RUN=0
